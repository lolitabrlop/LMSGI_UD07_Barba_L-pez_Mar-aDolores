<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_willmantech">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                    
                    <t t-set="display_discount" t-value="any(line.discount &gt; 0 for line in doc.invoice_line_ids if line.display_type == 'product')"/>

                    <t t-set="address">
                        <address t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' class="mb-0"/>
                        <div t-if="doc.partner_id.vat" class="mt-1">
                            <strong>CIF/NIF:</strong> <span t-field="doc.partner_id.vat"/>
                        </div>
                    </t>

                    <div class="page">
                        <h2>
                            <span>Factura de Cliente</span>
                        </h2>

                        <div class="row mt-4 mb-4" id="informations">
                            <div class="col-auto col-3" name="div_invoice_name">
                                <strong>Número de Factura:</strong>
                                <p class="m-0" t-field="doc.name">INV/2026/00001</p> 
                            </div>
                            <div class="col-auto col-3" name="div_invoice_date">
                                <strong>Fecha de Emisión:</strong>
                                <p class="m-0" t-field="doc.date" t-options='{"widget": "date"}'>2026-05-21</p>
                            </div>
                            <div class="col-auto col-3" name="div_salesperson" t-if="doc.invoice_user_id">
                                <strong>Gestor Comercial:</strong>
                                <p class="m-0" t-field="doc.invoice_user_id.name">Mitchell Admin</p>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table table-borderless mt-5">
                            <thead>
                                <tr>
                                    <th name="th_description" class="text-start">Descripción</th>
                                    <th name="th_quantity" class="text-end">Cantidad</th>
                                    <th name="th_priceunit" class="text-end">Precio Unitario</th>
                                    <th name="th_discount" t-if="display_discount" class="text-end">
                                        <span>Desc.%</span>
                                    </th>
                                    <th name="th_taxes" class="text-end">Impuestos</th>
                                    <th name="th_subtotal" class="text-end">Importe</th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <tr t-if="line.display_type == 'product'">
                                        <td name="account_invoice_line_name">
                                            <span t-field="line.name" t-options="{'widget': 'text'}">Línea de servicio tecnológico</span>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td t-if="display_discount" class="text-end">
                                            <span t-field="line.discount"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="', '.join(map(lambda x: (x.tax_label or x.name), line.tax_ids))"/>
                                        </td>
                                        <td class="text-end o_price_total">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="clearfix mt-4">
                            <div id="total" class="row">
                                <div class="col-6 ms-auto">
                                    <table class="table table-sm table-borderless">
                                        <tr class="border-black o_subtotal">
                                            <td><strong>Base Imponible</strong></td>
                                            <td class="text-end">
                                                <span t-field="doc.amount_untaxed"/>
                                            </td>
                                        </tr>
                                        <tr class="border-black o_total fw-bold text-primary">
                                            <td><strong>Total Neto</strong></td>
                                            <td class="text-end">
                                                <span t-field="doc.amount_total"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4" t-if="doc.invoice_payment_term_id">
                            <p><strong>Términos de Pago:</strong> <span t-field="doc.invoice_payment_term_id.note"/></p>
                        </div>

                        <div class="row mt-5 border-top pt-3" id="legal_warning">
                            <div class="col-12 text-muted small text-justify">
                                <p class="fw-bold text-danger">
                                    Atención: Este documento vinculante de explotación está sujeto a las condiciones generales de WillmanTech S.L.
                                </p>
                                <p style="font-size: 10px;">
                                    Protección de datos: En cumplimiento de la Ley Orgánica 3/2018 (LOPDGDD) y el RGPD europeo, le informamos que sus datos serán tratados de forma estrictamente confidencial por WillmanTech S.L. con fines de gestión comercial y facturación. Puede ejercer sus derechos de acceso, rectificación, supresión y portabilidad dirigiéndose a nuestro Delegado de Protección de Datos (DPO).
                                </p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>